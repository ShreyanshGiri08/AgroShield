# ==============================================================================
# AGROSHIELD ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database Connection String (with pgvector extension enabled)
# Example Supabase/Neon: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/agroshield

# Google Gemini API Key (Free tier available via Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Government of India Open Data Platform API Key (Optional / Free from https://data.gov.in/)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Local Embeddings Configuration (Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
